@verbatim
<!-- HERO -->
<div class="hero" id="hero">
  <svg class="hero-wave" viewBox="0 0 1200 104" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path class="w-red" pathLength="1" fill="none" stroke-width="13" stroke-linecap="round" d="M-40,52 C 230,14 470,80 740,36 C 970,6 1130,26 1260,12"/>
    <path class="w-blue" pathLength="1" fill="none" stroke-width="13" stroke-linecap="round" d="M-40,76 C 230,38 470,100 740,58 C 970,26 1130,50 1260,36"/>
  </svg>
  <div class="wrap hero-content">
    <div class="hero-layout">
      <!-- Left Column: Introduction & Narrative -->
      <div class="hero-intro reveal from-left">
        <div class="status-pill">
          <span class="status-dot-wrap">
            <span class="status-dot-ping"></span>
            <span class="status-dot-core"></span>
          </span>
          <span>{{ t.statusBadge }}</span>
          <span class="status-sep">·</span>
          <span class="status-loc">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 21s-7-4.35-7-10a7 7 0 0 1 14 0c0 5.65-7 10-7 10z"/><circle cx="12" cy="11" r="2.5"/></svg>
            {{ t.location }}
          </span>
        </div>

        <h1>Reza Pratama</h1>
        <div class="role">{{ t.role }}</div>
        <p class="sum">{{ t.summary }}</p>

        <div class="cta-row">
          <a class="btn primary" href="#project">
            {{ t.ctaProject }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
          </a>
          <a class="btn ghost" href="#contact" @click.prevent="openContactModal">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            {{ t.ctaContact }}
          </a>
        </div>

        <div class="chips">
          <span class="chip"><span class="dot" style="background:var(--navy)"></span>InfraNexia · 2026–{{ t.now }}</span>
          <span class="chip"><span class="dot" style="background:var(--red)"></span>Telkom Indonesia — RAM · 2020–2025</span>
          <span class="chip"><span class="dot" style="background:var(--blue)"></span>Telkom Akses Balikpapan · 2018</span>
        </div>
      </div>

      <!-- Right Column: Personal Photo Card -->
      <div class="hero-visual reveal from-right">
        <div class="hero-card">
          <img src="/images/fotodiri/Gemini_Generated_Image_spqjaxspqjaxspqj.jpg" alt="Reza Pratama — Full-Stack Developer" class="hero-photo" />
          <div class="hero-card-footer">
            <span class="hero-card-dot"></span>
            <span>{{ t.photoCaption }}</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
@endverbatim

<script>
Object.assign(I18N.en, {
  now:"Present",
  statusBadge:"Available for projects & collaboration",
  location:"Balikpapan, Indonesia",
  role:"Full-Stack Developer · Telecom & Enterprise Systems",
  summary:"Software engineer with 6+ years of experience building internal platforms, operational dashboards, and workflow automations across Telkom Group and InfraNexia. Focused on engineering reliable, intuitive applications that streamline field operations.",
  ctaProject:"Explore project list", ctaContact:"Get in touch",
  photoCaption:"6+ years of experience in Telkom Group & InfraNexia",
});
Object.assign(I18N.id, {
  now:"Sekarang",
  statusBadge:"Tersedia untuk proyek & kolaborasi",
  location:"Balikpapan, Indonesia",
  role:"Full-Stack Developer · Telecom & Enterprise Systems",
  summary:"Pengembang web dengan pengalaman lebih dari 6 tahun membangun sistem internal, dashboard operasional, dan otomasi alur kerja di lingkungan Telkom Group & InfraNexia. Fokus menciptakan aplikasi yang andal, efisien, dan benar-benar memudahkan pekerjaan tim di lapangan.",
  ctaProject:"Lihat daftar proyek", ctaContact:"Hubungi saya",
  photoCaption:"6+ tahun pengalaman di Telkom Group & InfraNexia",
});
</script>
